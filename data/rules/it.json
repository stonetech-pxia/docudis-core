        "verticals": [
          "employment",
          "healthcare"
        ],
        "protectionLevel": "essential",
        "defaultAction": "hide",
        "provenance": "doccloak",
        "status": "active"
      },
      "description": "Italian fiscal code (Codice Fiscale, 16 alphanumeric characters)",
      "examples": [
        "RSSMRA85M01H501Q"
      ],
      "validate": "codiceFiscale"
    },
