    },
    {
      "id": "regex:se:postal",
      "entityType": "ADDRESS",
      "pattern": "\\b\\d{3}\\s?\\d{2}\\s+[\\p{L}][\\p{L} \\t\\u00A0-]+\\b",
      "flags": "gu",
      "confidence": 0.8,
      "domains": [
        "contact"
      ],
      "classification": {
        "category": "location",
        "subtype": "postal_code",
        "applicability": "baseline",
        "verticals": [],
        "protectionLevel": "recommended",
        "defaultAction": "hide",
        "provenance": "doccloakModified",
        "status": "active"
      },
      "description": "Swedish postal code (XXX XX) followed by city name (Docudis change: no line break inside the name)",
      "examples": [
        "111 22 Stockholm",
        "41301 Göteborg"
      ]
    },
    {
      "id": "regex:se:currency_words",
      "entityType": "CURRENCY",
      "pattern": "(?:(?:med\\s+)?(?:bokstäver|ord)\\s*:\\s*|(?:summan|beloppet)\\s+)[\\p{L} \\t\\u00A0-]+(?:kronor|öre)\\b",
      "flags": "giu",
      "confidence": 0.9,
      "domains": [
        "financial"
      ],
      "classification": {
        "category": "financialValue",
        "subtype": "amount",
        "applicability": "specialized",
        "verticals": [
          "finance"
        ],
        "protectionLevel": "optional",
        "defaultAction": "detectOnly",
        "provenance": "doccloakModified",
        "status": "active"
      },
      "description": "Swedish amount written in words (e.g., \"med bokstäver: åttatusen femhundra kronor\") (Docudis change: no line break inside the name)",
      "examples": [
        "med bokstäver: åttatusen femhundra kronor"
      ]
    },
    {
