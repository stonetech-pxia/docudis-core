    {
      "id": "regex:se:personnummer",
      "entityType": "SSN",
      "pattern": "\\b\\d{6}[-+]?\\d{4}\\b",
      "flags": "g",
      "confidence": 0.85,
      "domains": [
        "identity",
        "hr",
        "medical"
      ],
      "classification": {
        "category": "identity",
        "subtype": "social_security_number",
        "applicability": "baseline",
        "verticals": [
          "employment",
          "healthcare"
        ],
        "protectionLevel": "essential",
        "defaultAction": "hide",
        "provenance": "doccloak",
        "status": "active"
      },
      "description": "Swedish personnummer (YYMMDD-XXXX or YYMMDDXXXX)",
      "examples": [
        "850523-0006",
        "8505230006"
      ],
      "validate": "personnummer"
    },
    {
      "id": "regex:se:personnummer_12",
      "entityType": "SSN",
      "pattern": "\\b(?:19|20)\\d{6}[-+]?\\d{4}\\b",
