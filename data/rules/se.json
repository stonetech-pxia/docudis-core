      "entityType": "ADDRESS",
      "pattern": "[\\p{L}][\\p{L} \\t\\u00A0-]*(?:gatan|vägen|stigen|torget|platsen|gränd|backen|liden|ängen)\\s+\\d+[\\p{L}]?",
