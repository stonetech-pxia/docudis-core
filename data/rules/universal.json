    {
      "id": "regex:universal:labeled_id",
      "entityType": "SSN",
      "pattern": "(?<=[\\p{L}][\\p{L}\\s.()\\d-]{0,30}[:#][ \\t\\u00A0]{0,20})(?:(?=[A-Z0-9/-]*\\d)(?:[A-Z0-9][A-Z0-9/-]{5,}|[A-Z0-9][A-Z0-9-]*/[A-Z0-9/-]{2,})|[A-Z0-9]{2,4}[\\s-]?\\d{4,}(?:[\\s-]\\d+)*)\\b",
      "flags": "giu",
      "confidence": 0.7,
      "domains": [
        "identity",
        "general"
      ],
      "classification": {
        "category": "genericIdentifier",
        "subtype": "labeled_identifier",
        "applicability": "baseline",
        "verticals": [],
        "protectionLevel": "essential",
        "defaultAction": "hide",
        "provenance": "doccloakModified",
        "status": "active"
      },
      "description": "Labeled identifier (Key: Value pattern, e.g. \"ID: ABC12345\", \"Chassis no. (last 6): 408213\"). Docudis change 2026-09-21: the value shape gained two alternatives (6+ characters, or any length containing a slash, both requiring a digit) and the label may now contain dots, parentheses and digits. The original shape is kept as the last alternative: dropping it turned seven half-hidden account and policy numbers back into full leaks.",
      "examples": [
        "ID: ABC12345",
        "Nº de colegiado: 36/3607152",
        "Nº de bastidor: VSSZZZKLZNR041877"
      ],
      "falsePositiveNotes": "Broad pattern — catches many key:value pairs that may not be PII"
    },
    {
