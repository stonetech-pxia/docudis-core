    },
    {
      "id": "regex:gb:bank_account",
      "entityType": "OTHER",
      "pattern": "\\b\\d{7,8}\\b",
      "flags": "g",
      "confidence": 0.3,
      "domains": [
        "financial"
      ],
      "classification": {
        "category": "financialAccount",
        "subtype": "bank_account",
        "applicability": "baseline",
        "verticals": [
          "finance"
        ],
        "protectionLevel": "essential",
        "defaultAction": "hide",
        "provenance": "doccloak",
        "status": "active"
      },
      "description": "UK bank account number (7-8 digits)",
      "examples": [
        "12345678"
      ],
      "falsePositiveNotes": "Extremely broad — disabled by default in low-sensitivity mode"
    },
    {
      "id": "regex:gb:vat",
      "entityType": "SSN",
      "pattern": "\\b(?:GB)?\\d{3}\\s?\\d{4}\\s?\\d{2}(?:\\s?\\d{3})?\\b",
      "flags": "gi",
      "confidence": 0.75,
      "domains": [
        "financial",
        "legal"
      ],
      "classification": {
        "category": "businessRecord",
        "subtype": "business_tax_id",
        "applicability": "specialized",
        "verticals": [
          "finance",
          "legal"
        ],
        "protectionLevel": "recommended",
        "defaultAction": "hide",
        "provenance": "doccloak",
        "status": "active"
      },
      "description": "UK VAT number (GB + 9 or 12 digits)",
      "examples": [
        "GB123 4567 89",
        "GB123456789"
      ]
    },
    {
      "id": "regex:gb:phone_landline",
      "entityType": "PHONE",
      "pattern": "\\b0(?:\\d{4}\\s?\\d{6}|\\d{3}\\s?\\d{3}\\s?\\d{4}|\\d{2}\\s?\\d{4}\\s?\\d{4}|\\d{4}\\s?\\d{3}\\s?\\d{3})\\b",
      "flags": "g",
      "confidence": 0.8,
      "domains": [
        "contact"
      ],
      "classification": {
        "category": "contact",
        "subtype": "landline_phone",
        "applicability": "baseline",
        "verticals": [],
        "protectionLevel": "essential",
        "defaultAction": "hide",
        "provenance": "doccloakModified",
        "status": "active"
      },
      "description": "UK landline phone number in its usual spacings (01234 567890, 0161 276 1234, 020 7946 0958) (Docudis change: the original only took 5+6 digits)",
      "examples": [
        "01234 567890",
        "02079 460958",
        "0161 276 1234",
        "020 7946 0958"
      ]
    },
    {
      "id": "regex:gb:phone_mobile",
      "entityType": "PHONE",
      "pattern": "\\b07\\d{3}\\s?\\d{6}\\b",
      "flags": "g",
      "confidence": 0.85,
      "domains": [
        "contact"
      ],
      "classification": {
        "category": "contact",
        "subtype": "mobile_phone",
        "applicability": "baseline",
        "verticals": [],
        "protectionLevel": "essential",
        "defaultAction": "hide",
        "provenance": "doccloak",
        "status": "active"
      },
      "description": "UK mobile phone number (07XXX XXXXXX)",
      "examples": [
        "07911 123456"
      ]
    },
    {
      "id": "regex:gb:postcode",
      "entityType": "ADDRESS",
      "pattern": "\\b[A-Z]{1,2}\\d[A-Z\\d]?\\s?\\d[A-Z]{2}\\b",
      "flags": "gi",
      "confidence": 0.8,
      "domains": [
        "contact"
      ],
      "classification": {
        "category": "location",
        "subtype": "postal_code",
        "applicability": "baseline",
        "verticals": [],
        "protectionLevel": "recommended",
        "defaultAction": "hide",
        "provenance": "doccloak",
        "status": "active"
      },
      "description": "UK postcode (e.g., SW1A 1AA, EC2A 1NT, M1 1AA)",
      "examples": [
        "SW1A 1AA",
        "EC2A 1NT",
        "M1 1AA",
        "B33 8TH"
      ]
    },
    {
      "id": "regex:gb:currency_words",
      "entityType": "CURRENCY",
      "pattern": "(?:in\\s+(?:the\\s+)?(?:amount|sum)\\s+of|pay(?:able)?(?:\\s+the\\s+(?:amount|sum))?\\s+of)\\s+[\\p{L} \\t\\u00A0-]+(?:pounds?|pence|sterling)\\b",
      "flags": "giu",
      "confidence": 0.9,
      "domains": [
        "financial"
      ],
      "classification": {
        "category": "financialValue",
        "subtype": "amount",
        "applicability": "specialized",
        "verticals": [
          "finance"
        ],
        "protectionLevel": "optional",
        "defaultAction": "detectOnly",
        "provenance": "doccloakModified",
        "status": "active"
      },
      "description": "English (UK) amount written in words (e.g., \"in the amount of eight thousand five hundred pounds\") (Docudis change: no line break inside the name)",
      "examples": [
        "in the amount of eight thousand five hundred pounds"
      ]
    },
    {
      "id": "regex:gb:street",
      "entityType": "ADDRESS",
      "pattern": "\\b\\d{1,4}[A-Z]?\\s+[A-Z][\\w]+(?:\\s+[A-Z][\\w]+)*\\s+(?:Street|St|Road|Rd|Avenue|Ave|Lane|Ln|Drive|Dr|Close|Cl|Crescent|Cres|Terrace|Terr|Place|Pl|Gardens|Gdns|Grove|Way|Court|Ct|Square|Sq|Mews|Row|Rise|Hill|Park|Gate|Walk|Green|Parade|Wharf|STREET|ST|ROAD|RD|AVENUE|AVE|LANE|LN|DRIVE|DR|CLOSE|CL|CRESCENT|CRES|TERRACE|TERR|PLACE|PL|GARDENS|GDNS|GROVE|WAY|COURT|CT|SQUARE|SQ|MEWS|ROW|RISE|HILL|PARK|GATE|WALK|GREEN|PARADE|WHARF)\\.?\\b",
      "flags": "g",
      "confidence": 0.85,
      "domains": [
        "contact"
      ],
      "classification": {
        "category": "location",
        "subtype": "street_address",
        "applicability": "baseline",
        "verticals": [],
        "protectionLevel": "recommended",
        "defaultAction": "hide",
        "provenance": "doccloakModified",
        "status": "active"
      },
      "description": "UK street address (number + street name + type) (Docudis change 2026-09-18: case-sensitive, the name and the street type are capitalised or in capitals; with the i flag \"10 minute drive\", \"5 minute walk\" and \"15 percent rise\" were addresses)",
      "examples": [
        "10 Downing Street",
        "221B Baker Street",
        "42 Oxford Road"
      ]
    },
    {
      "id": "regex:gb:company",
      "entityType": "COMPANY",
      "pattern": "(?<![\\p{L}\\d])(?:\\p{Lu}[\\p{L}\\d.'’&-]*|\\d+[\\p{L}\\d]*)(?:[ \\u00A0](?:(?:of|and|the|for|&)[ \\u00A0])*(?:\\p{Lu}[\\p{L}\\d.'’&-]*|\\d+[\\p{L}\\d]*)){0,7},?[ \\u00A0](?:Ltd\\.?|LTD\\.?|Limited|LIMITED|PLC|plc|LLP|L\\.L\\.P\\.)(?![\\p{L}\\d])(?![ \\u00A0]?:)",
      "flags": "gu",
      "confidence": 0.85,
      "domains": [
        "legal",
        "financial"
      ],
      "classification": {
        "category": "organization",
        "subtype": "company",
        "applicability": "baseline",
        "verticals": [
          "legal",
          "finance"
        ],
        "protectionLevel": "recommended",
        "defaultAction": "hide",
        "provenance": "doccloakModified",
        "status": "active"
      },
      "description": "UK company name with legal suffix (Ltd, PLC, LLP) (Docudis change 2026-09-18: the name must be a run of capitalised words, so the sentence before the company is no longer swallowed; a form label followed by a colon is not a company; \"Limited\" written in full)",
      "examples": [
        "Acme Ltd",
        "ALPHA KILO CREATIVE LIMITED",
        "Calder & Finch LLP"
      ]
    },
    {
      "id": "regex:gb:labeled_company",
      "entityType": "COMPANY",
      "pattern": "(?<=(?:Name of Company|Company name|Registered name|Employer)[ \\u00A0]?:[ \\u00A0]?)\\p{Lu}[^\\n,;:]{1,79}?(?=[ \\u00A0]*(?:[,;\\n]|$))",
      "flags": "gmu",
      "confidence": 0.8,
      "domains": [
        "legal"
      ],
      "classification": {
        "category": "organization",
        "subtype": "company",
        "applicability": "baseline",
        "verticals": [
          "legal"
        ],
        "protectionLevel": "recommended",
        "defaultAction": "hide",
        "provenance": "docudis",
        "status": "active"
      },
      "description": "Company name after a form label such as \"Name of Company:\" or \"Employer:\" (Docudis addition). The value must start with a capital.",
      "examples": [
        "Name of Company: ALPHA KILO CREATIVE",
        "Employer: Pennine Office Solutions"
      ]
    },
    {
      "id": "regex:gb:driving_licence",
      "entityType": "SSN",
      "pattern": "\\b[A-Z9]{5}\\s?\\d{6}\\s?[A-Z9]{2}\\d[A-Z]{2}\\b",
      "flags": "g",
      "confidence": 0.8,
      "domains": [
        "identity"
      ],
      "classification": {
        "category": "identity",
        "subtype": "driving_licence",
        "applicability": "baseline",
        "verticals": [],
        "protectionLevel": "essential",
        "defaultAction": "hide",
        "provenance": "doccloak",
        "status": "active"
      },
      "description": "UK driving licence number (16 chars: surname block, encoded date of birth, initials, check chars)",
      "examples": [
        "MORGA657054SM9IJ",
        "SMITH 751125 JM9AB"
      ],
      "falsePositiveNotes": "Best-effort: other 16-char uppercase codes can match the shape; the validator checks the embedded date-of-birth digit block",
      "validate": "ukDrivingLicence"
    },
    {
      "id": "regex:gb:company_tail",
      "entityType": "COMPANY",
      "pattern": "(?<![\\p{L}\\d])(?:\\p{Lu}[\\p{L}\\d.'’&-]*)(?:[ \\u00A0](?:(?:of|and|the|for|&)[ \\u00A0])*\\p{Lu}[\\p{L}\\d.'’&-]*){0,5}[ \\u00A0](?:Bank|Credit Union|Building Society|Haulage|Motors|Pharmacy|Dental Practice)(?![\\p{L}\\d])",
      "flags": "gu",
      "confidence": 0.8,
      "domains": [
        "financial",
        "general"
      ],
      "classification": {
        "category": "organization",
        "subtype": "company",
        "applicability": "baseline",
        "verticals": [
          "finance"
        ],
        "protectionLevel": "recommended",
        "defaultAction": "hide",
        "provenance": "docudis",
        "status": "active"
      },
      "description": "A firm named by the trade that ends its name rather than by a legal form: \"First Midwest Bank\", \"Alliant Credit Union\" (Docudis addition 2026-09-21). \"Surgery\" and \"Practice\" on their own are deliberately not in the list: they matched \"Chief of Cardiothoracic Surgery\", which is a job.",
      "examples": [
        "First Midwest Bank",
        "Alliant Credit Union",
        "JTS Haulage"
      ]
    }
  ]
}
