      "confidence": 0.65,
      "domains": [
        "financial",
        "legal"
      ],
      "classification": {
        "category": "businessRecord",
        "subtype": "business_tax_id",
        "applicability": "specialized",
        "verticals": [
          "finance",
          "legal"
        ],
        "protectionLevel": "recommended",
        "defaultAction": "hide",
        "provenance": "doccloak",
        "status": "active"
      },
      "description": "German VAT number (USt-IdNr., DE + 9 digits)",
      "examples": [
        "DE123456789"
      ],
      "falsePositiveNotes": "Without DE prefix, 9 digits alone has many false positives"
    },
    {
