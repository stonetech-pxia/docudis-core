        "hr"
      ],
      "classification": {
        "category": "identity",
        "subtype": "social_security_number",
        "applicability": "baseline",
        "verticals": [
          "employment"
        ],
        "protectionLevel": "essential",
        "defaultAction": "hide",
        "provenance": "doccloak",
        "status": "active"
      },
      "description": "Finnish personal identity code (henkilötunnus / HETU)",
      "examples": [
        "131052-308T"
      ],
      "validate": "hetu"
