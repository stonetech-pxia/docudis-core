{
  "schemaVersion": 2,
  "region": "no",
  "scope": {
    "jurisdictions": [
      "NO"
    ],
    "languages": [
      "no",
      "nb",
      "nn"
    ]
  },
  "rules": [
    {
      "id": "regex:no:fodselsnummer",
      "entityType": "SSN",
      "pattern": "\\b\\d{6}\\s?\\d{5}\\b",
      "flags": "g",
      "confidence": 0.8,
      "domains": [
        "identity",
        "hr",
        "medical"
      ],
      "classification": {
        "category": "identity",
        "subtype": "social_security_number",
        "applicability": "baseline",
        "verticals": [
          "employment",
          "healthcare"
        ],
        "protectionLevel": "essential",
        "defaultAction": "hide",
        "provenance": "doccloak",
        "status": "active"
      },
      "description": "Norwegian fødselsnummer (birth number, 11 digits, DDMMYY + 5)",
      "examples": [
        "01019912368"
      ],
      "falsePositiveNotes": "11-digit sequences are common in other contexts",
      "validate": "fodselsnummer"
    },
    {
      "id": "regex:no:d_nummer",
      "entityType": "SSN",
      "pattern": "\\b\\d{6}\\s?\\d{5}\\b",
      "flags": "g",
      "confidence": 0.4,
      "domains": [
        "identity"
      ],
      "classification": {
        "category": "identity",
        "subtype": "social_security_number",
        "applicability": "baseline",
        "verticals": [],
        "protectionLevel": "essential",
        "defaultAction": "hide",
        "provenance": "doccloak",
        "status": "active"
      },
      "description": "Norwegian D-nummer (temporary ID for foreigners, 11 digits, day +40)",
      "examples": [
        "41019912345"
      ],
      "falsePositiveNotes": "Very broad match — 9 digits",
      "validate": "dNummer"
    },
    {
      "id": "regex:no:orgnr",
      "entityType": "SSN",
      "pattern": "\\b\\d{9}\\s?(?:MVA)?\\b",
      "flags": "g",
      "confidence": 0.6,
      "domains": [
        "financial",
        "legal"
      ],
      "classification": {
        "category": "businessRecord",
        "subtype": "business_registration",
        "applicability": "specialized",
        "verticals": [
          "finance",
          "legal"
        ],
        "protectionLevel": "recommended",
        "defaultAction": "hide",
        "provenance": "doccloak",
        "status": "active"
      },
      "description": "Norwegian organization number (9 digits, optionally followed by MVA)",
      "examples": [
        "123456789",
        "123456789 MVA"
      ]
    },
    {
      "id": "regex:no:phone",
      "entityType": "PHONE",
      "pattern": "\\b(?:\\+?47[\\s-]?)?\\d{2}[\\s-]?\\d{2}[\\s-]?\\d{2}[\\s-]?\\d{2}\\b",
      "flags": "g",
      "confidence": 0.8,
      "domains": [
        "contact"
      ],
      "classification": {
        "category": "contact",
        "subtype": "phone",
        "applicability": "baseline",
        "verticals": [],
        "protectionLevel": "essential",
        "defaultAction": "hide",
        "provenance": "doccloak",
        "status": "active"
      },
      "description": "Norwegian phone number (8 digits, optionally with +47)",
      "examples": [
        "+47 12 34 56 78",
        "12345678"
      ]
    },
    {
      "id": "regex:no:postal",
      "entityType": "ADDRESS",
      "pattern": "\\b\\d{4}\\s+[\\p{L}][\\p{L} \\t\\u00A0-]+\\b",
      "flags": "gu",
      "confidence": 0.8,
      "domains": [
        "contact"
      ],
      "classification": {
        "category": "location",
        "subtype": "postal_code",
        "applicability": "baseline",
        "verticals": [],
        "protectionLevel": "recommended",
        "defaultAction": "hide",
        "provenance": "doccloakModified",
        "status": "active"
      },
      "description": "Norwegian postal code (4 digits) followed by city name (Docudis change: no line break inside the name)",
      "examples": [
        "0001 Oslo",
        "5003 Bergen"
      ]
    },
    {
      "id": "regex:no:currency_words",
      "entityType": "CURRENCY",
      "pattern": "(?:(?:med\\s+)?(?:bokstaver|ord)\\s*:\\s*|(?:summen|beløpet)\\s+)[\\p{L} \\t\\u00A0-]+(?:kroner|øre)\\b",
      "flags": "giu",
      "confidence": 0.9,
      "domains": [
        "financial"
      ],
      "classification": {
        "category": "financialValue",
        "subtype": "amount",
        "applicability": "specialized",
        "verticals": [
          "finance"
        ],
        "protectionLevel": "optional",
        "defaultAction": "detectOnly",
        "provenance": "doccloakModified",
        "status": "active"
      },
      "description": "Norwegian amount written in words (e.g., \"med bokstaver: åtte tusen fem hundre kroner\") (Docudis change: no line break inside the name)",
      "examples": [
        "med bokstaver: åtte tusen fem hundre kroner"
      ]
    },
    {
      "id": "regex:no:street",
      "entityType": "ADDRESS",
      "pattern": "[\\p{L}][\\p{L} \\t\\u00A0-]*(?:gata|gaten|gate|veien|vegen|vei|veg|stien|torget|plassen|plass|allé|alleen)\\s+\\d+[\\p{L}]?",
      "flags": "giu",
      "confidence": 0.9,
      "domains": [
        "contact"
      ],
      "classification": {
        "category": "location",
        "subtype": "street_address",
        "applicability": "baseline",
        "verticals": [],
        "protectionLevel": "recommended",
        "defaultAction": "hide",
        "provenance": "doccloakModified",
        "status": "active"
      },
      "description": "Norwegian street address (name + gate/veien/vei/etc. + number) (Docudis change: no line break inside the name)",
      "examples": [
        "Karl Johans gate 22",
        "Storgata 15",
        "Bygdøy allé 3"
      ]
    },
    {
      "id": "regex:no:company",
      "entityType": "COMPANY",
      "pattern": "[\\p{L}][\\p{L} \\t\\u00A0&.']+(?:\\s+)?(?:AS|ASA|ANS|DA)\\b",
      "flags": "gu",
      "confidence": 0.8,
      "domains": [
        "legal",
        "financial"
      ],
      "classification": {
        "category": "organization",
        "subtype": "company",
        "applicability": "baseline",
        "verticals": [
          "legal",
          "finance"
        ],
        "protectionLevel": "recommended",
        "defaultAction": "hide",
        "provenance": "doccloakModified",
        "status": "active"
      },
      "description": "Norwegian company name with legal form (AS, ASA, ANS, DA) (Docudis change: no line break inside the name)",
      "examples": [
        "Equinor ASA",
        "Telenor ASA",
        "Nordea Bank ASA"
      ]
    }
  ]
}
