    },
    {
      "id": "regex:fr:phone",
      "entityType": "PHONE",
      "pattern": "(?<!\\d[.-]?)\\b0[1-9](?:(?:(?:[ \\u00A0]|[ \\u00A0]?\\r?\\n)\\d{2}){4}|([.-]?)\\d{2}(?:\\1\\d{2}){3})\\b(?![.-]?\\d)",
      "flags": "g",
      "confidence": 0.85,
      "domains": [
        "contact"
      ],
      "classification": {
        "category": "contact",
        "subtype": "phone",
        "applicability": "baseline",
        "verticals": [],
        "protectionLevel": "essential",
        "defaultAction": "hide",
        "provenance": "doccloakModified",
        "status": "active"
      },
      "description": "French phone number (0X XX XX XX XX) (Docudis change 2026-09-18: pairs may be separated by a dot or a hyphen, \"01.23.45.67.89\" was an IP address followed by \".89\"; the same separator throughout, so the date and hour \"01.02.2024 12:30\" is not a phone. 2026-09-19: a number written with spaces may wrap onto the next line, as OCR and PDF text give it; dotted, hyphenated and unspaced numbers still stay on one line)",
      "examples": [
        "01 23 45 67 89",
        "06 12 34 56 78",
        "0612345678",
        "01.23.45.67.89",
        "06-12-34-56-78"
      ]
    },
    {
      "id": "regex:fr:postal",
      "entityType": "ADDRESS",
      "pattern": "(?<!\\d{3}[ \\u00A0]\\d{3}[ \\u00A0])\\b\\d{5}[ \\u00A0]\\p{Lu}[\\p{L}'’-]*(?:[ \\u00A0-](?:(?:sur|sous|de|du|des|la|le|les|en|lès|aux|del|los|las)[ \\u00A0-])*\\p{Lu}[\\p{L}'’-]*)*(?:[ \\u00A0]\\d{1,2}(?:er|e|ème)[ \\u00A0]Arrondissement)?(?![\\p{L}])",
      "flags": "gu",
      "confidence": 0.8,
      "domains": [
        "contact"
      ],
      "classification": {
        "category": "location",
        "subtype": "postal_code",
        "applicability": "baseline",
        "verticals": [],
        "protectionLevel": "recommended",
        "defaultAction": "hide",
        "provenance": "doccloakModified",
        "status": "active"
      },
      "description": "French postal code (5 digits) followed by city name (Docudis change 2026-09-18: exactly one space, a capitalised city and no SIREN-like pair of digit groups before the code: the tail of a SIRET followed by a table heading is not a postcode)",
      "examples": [
        "75001 Paris",
        "13100 Aix-en-Provence",
        "97600 MAMOUDZOU",
        "13007 Marseille 7e Arrondissement"
      ]
    },
    {
      "id": "regex:fr:currency_words",
      "entityType": "CURRENCY",
      "pattern": "(?:(?:soit|montant)\\s+(?:en\\s+)?(?:lettres?|toutes?\\s+lettres?)\\s*:\\s*|(?:la\\s+)?somme\\s+de\\s+)[\\p{L} \\t\\u00A0'-]+(?:euros?|centimes?)\\b",
      "flags": "giu",
      "confidence": 0.9,
      "domains": [
        "financial"
      ],
      "classification": {
        "category": "financialValue",
        "subtype": "amount",
        "applicability": "specialized",
        "verticals": [
          "finance"
        ],
        "protectionLevel": "optional",
        "defaultAction": "detectOnly",
        "provenance": "doccloakModified",
        "status": "active"
      },
      "description": "French amount written in words (e.g., \"soit en lettres: huit mille cinq cents euros\") (Docudis change: no line break inside the name)",
      "examples": [
        "soit en lettres: huit mille cinq cents euros"
      ]
    },
    {
      "id": "regex:fr:street",
      "entityType": "ADDRESS",
      "pattern": "\\b\\d{1,5}(?:[ \\u00A0]?(?:bis|ter|[a-z])\\b)?\\s*,?\\s*(?:rue|avenue|av\\.|boulevard|bd\\.?|place|pl\\.|impasse|allée|passage|chemin|route|quai|cours|square|voie|sentier|résidence)\\s+[\\p{L}][\\p{L} \\t\\u00A0'-]+",
      "flags": "giu",
      "confidence": 0.9,
      "domains": [
        "contact"
      ],
      "classification": {
        "category": "location",
        "subtype": "street_address",
        "applicability": "baseline",
        "verticals": [],
        "protectionLevel": "recommended",
        "defaultAction": "hide",
        "provenance": "doccloakModified",
        "status": "active"
      },
      "description": "French street address (number + rue/avenue/boulevard + name) (Docudis change 2026-09-18: house numbers with a letter, \"7b Rue de Fruges\", \"3 B Rue du Commerce\")",
      "examples": [
        "12 rue de Rivoli",
        "42 avenue des Champs-Élysées",
        "8 bis boulevard Haussmann",
        "7b Rue de Fruges",
        "3 B Rue du Commerce"
      ]
    },
    {
      "id": "regex:fr:company",
      "entityType": "COMPANY",
      "pattern": "(?<![\\p{L}\\d])(?:\\p{Lu}[\\p{L}\\d.'’&-]*|\\d+[\\p{L}\\d]*)(?:[ \\u00A0](?:(?:de|du|des|la|le|les|et|en|à|aux|&)[ \\u00A0])*(?:\\p{Lu}[\\p{L}\\d.'’&-]*|\\d+[\\p{L}\\d]*)){0,7},?[ \\u00A0](?:SARL|S\\.A\\.R\\.L\\.|SASU|SAS|S\\.A\\.S\\.|SA|S\\.A\\.|EURL|SCI|SNC|SELARL|SCP|GIE)(?![\\p{L}\\d])(?![ \\u00A0]?:)",
      "flags": "gu",
      "confidence": 0.9,
      "domains": [
        "legal",
        "financial"
      ],
      "classification": {
        "category": "organization",
        "subtype": "company",
        "applicability": "baseline",
        "verticals": [
          "legal",
          "finance"
        ],
        "protectionLevel": "recommended",
        "defaultAction": "hide",
        "provenance": "doccloakModified",
        "status": "active"
      },
      "description": "French company name with legal form (SARL, SAS, SA, EURL, SCI, SNC) (Docudis change 2026-09-18: the name must be a run of capitalised words, so the sentence before the company is no longer swallowed; a form label followed by a colon is not a company)",
      "examples": [
        "Total SA",
        "Capgemini SAS",
        "Dupont et Fils SARL"
      ]
    },
    {
      "id": "regex:fr:company_prefix",
      "entityType": "COMPANY",
      "pattern": "(?<![\\p{L}\\d])(?:SARL|Sarl|SASU|SAS|Sas|EURL|SCI|SNC|SELARL|Selarl|SCP)[ \\u00A0]\\p{Lu}[\\p{L}\\d.'’&-]*(?:[ \\u00A0](?:(?:de|du|des|la|le|les|et|en|&)[ \\u00A0])*\\p{Lu}[\\p{L}\\d.'’&-]*){0,5}",
      "flags": "gu",
      "confidence": 0.85,
      "domains": [
        "legal"
      ],
      "classification": {
        "category": "organization",
        "subtype": "company",
        "applicability": "baseline",
        "verticals": [
          "legal"
        ],
        "protectionLevel": "recommended",
        "defaultAction": "hide",
        "provenance": "docudis",
