          "healthcare",
          "employment"
        ],
        "protectionLevel": "essential",
        "defaultAction": "hide",
        "provenance": "doccloak",
        "status": "active"
      },
      "description": "French NIR / INSEE number (numéro de sécurité sociale, 13+2 digits)",
      "examples": [
        "1 85 05 78 049 013 36"
      ],
      "validate": "nir"
    },
