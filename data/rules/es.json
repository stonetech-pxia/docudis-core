        "B87654321"
      ]
    },
    {
      "id": "regex:es:cuenta_bancaria",
      "entityType": "SSN",
      "pattern": "\\b(?:ES)?\\d{2}\\s?\\d{4}\\s?\\d{4}\\s?\\d{4}\\s?\\d{4}\\s?\\d{4}\\b",
      "flags": "gi",
      "confidence": 0.8,
      "domains": [
        "financial"
      ],
      "classification": {
        "category": "financialAccount",
        "subtype": "bank_account",
        "applicability": "baseline",
